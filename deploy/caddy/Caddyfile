# Caddyfile - Configuração de Proxy Reverso Seguro HTTPS para Monitor APS Pacujá
# Garante TLS 1.3/1.2 automático, cabeçalhos de proteção e isolamento estrito
# NUNCA exponha a porta 5000 diretamente à Internet. O tráfego externo passa exclusivamente por aqui.

{
    # Configurações globais
    admin off
    email saude@pacuja.ce.gov.br
}

# Altere pelo domínio oficial municipal registrado, ex: siaps.pacuja.ce.gov.br
# Em ambiente local de homologação/rede fechada, pode-se usar localhost ou IP interno
{$SERVER_NAME:localhost} {
    # Redirecionamento e terminação segura TLS
    tls {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
    }

    # Limite máximo do corpo de requisição (2 MB para proteção contra DoS)
    request_body {
        max_size 2MB
    }

    # Cabeçalhos HTTP de Segurança Avançada (OWASP ASVS / CIS Benchmark)
    header {
        # Previne clickjacking
        X-Frame-Options "DENY"
        # Previne MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Política de referência estrita
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restringe permissões do navegador (geolocalização, câmera, microfone)
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        # HSTS (Strict-Transport-Security) - 1 ano + subdomínios
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Content-Security-Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';"
        # Remove assinatura do servidor
        -Server
    }

    # Compressão automática gzip e zstd
    encode zstd gzip

    # Proxy reverso seguro estritamente vinculado à porta local de loopback 127.0.0.1:5000
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Timeouts de transporte e conexão
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }

    # Log estruturado em formato JSON para auditoria
    log {
        output file /var/log/caddy/siaps_access.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 90d
        }
        format json
    }
}
