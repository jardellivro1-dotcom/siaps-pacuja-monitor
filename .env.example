# Exemplo de configuração de ambiente para o Monitor APS Pacujá
# Copie este arquivo para .env e ajuste as configurações conforme o ambiente.

# Ambiente de execução: development, staging ou production
FLASK_ENV=development

# Chave secreta da aplicação web
SIAPS_SECRET_KEY=dev-secret-key-change-in-production

# Chave administrativa opcional para proteger operações de mutação (POST /api/sync e POST/PUT/DELETE /api/actions)
# Se não definida, as rotas de mutação ficam abertas localmente.
# SIAPS_ADMIN_KEY=sua-chave-administrativa-forte-aqui

# Caminhos personalizados (opcionais, valores padrão apontam para ./data)
# DATABASE_PATH=data/siaps_monitor.db
# RAW_DATA_DIR=data/raw
